<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>

        <IsPackable>false</IsPackable>
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
        <RootNamespace>Microsoft.Azure.ApiManagement.PolicyToolkit.Generators</RootNamespace>
    </PropertyGroup>

    <PropertyGroup>
        <!-- RS1041: .NET 8.0 target framework warning - safe to suppress for internal generators -->
        <!-- RS1042: Generator performance warning - suppressed for generator-specific context usage -->
        <NoWarn>$(NoWarn);RS1041;RS1042</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" PrivateAssets="all" />
    </ItemGroup>

</Project>
